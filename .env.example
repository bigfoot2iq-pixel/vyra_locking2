# Chain: ink (mainnet) | inkSepolia | anvil (local)
NEXT_PUBLIC_CHAIN=inkSepolia

# From contracts/deployments/<chainId>.json after deploying
NEXT_PUBLIC_LOCKING_ADDRESS=
NEXT_PUBLIC_POOL_ADDRESS=
NEXT_PUBLIC_NFT_ADDRESS=

# Optional: WalletConnect Cloud project id (enables mobile & more wallets)
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional: fixed USD price per token for testnets (mainnet uses DexScreener)
NEXT_PUBLIC_TOKEN_USD_PRICE=
